# ═══════════════════════════════════════════════
# Invest Solo — API Keys Configuration
# ═══════════════════════════════════════════════
# Copy this file to .env and fill in your keys
# NEVER commit .env to git
# ═══════════════════════════════════════════════

# Financial Modeling Prep (recommended - best value)
# Get key at: https://financialmodelingprep.com/developer/docs
FMP_KEY=

# Alpha Vantage (25 free requests/day)
# Get key at: https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_KEY=

# Finnhub (60 calls/min free)
# Get key at: https://finnhub.io/register
FINNHUB_KEY=

# EODHD (20 calls/day free)
# Get key at: https://eodhd.com/register
EODHD_KEY=

# Financial Datasets (OAuth or API key)
# Get key at: https://financialdatasets.ai/
FINANCIAL_DATASETS_KEY=
